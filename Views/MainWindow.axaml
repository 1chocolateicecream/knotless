<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:knotless.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="knotless.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="knotless">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to enable proper value assistance. -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="knotless"
                FontSize="32"
                Foreground="#98d4c0"
                HorizontalAlignment="Center"/>

        <TextBlock Text="chaos refined into order."
                FontSize="14"
                Opacity="0.6"
                HorizontalAlignment="Center"/>

        <Button Content="start weaving"
                Command="{Binding StartWeavingCommand}"
                Padding="12,6"
                HorizontalAlignment="Center"
                Background="#f5e5ac"
                Foreground="black"/>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="select folder"
                    Command="{Binding SelectFolderCommand}"
                    Padding="10,5"
                    FontSize="12"
                    Background="#c8ddd8"
                    Foreground="black"/>

            <Button Content="{Binding LiveStatus}"
                    Command="{Binding ToggleLiveCommand}"
                    Padding="10,5"
                    FontSize="12"
                    Background="#c8ddd8"
                    Foreground="black"/>
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}"
                HorizontalAlignment="Center"
                FontSize="12"
                Opacity="0.5" />
    </StackPanel>
</Window>