<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:knotless.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="knotless.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="knotless">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to enable proper value assistance. -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="knotless"
                FontSize="32"
                Foreground="#FF69B4"
                HorizontalAlignment="Center"/>

        <TextBlock Text="chaos refined into order."
                FontSize="14"
                Opacity="0.6"
                HorizontalAlignment="Center"/>

        <TextBlock Text="{Binding Greeting}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

        <Button Content="start weaving"
                Command="{Binding StartWeavingCommand}"
                Padding="10,5"
                HorizontalAlignment="Center"
                Background="#4B0082"
                Foreground="White"/>
    </StackPanel>
</Window>